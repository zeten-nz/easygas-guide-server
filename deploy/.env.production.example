###############################################################################
#  EASY GAS — PRODUCTION ENVIRONMENT TEMPLATE
###############################################################################
#
#  !!!  DO NOT COMMIT THE REAL FILE.  DO NOT PUT REAL SECRETS IN THIS TEMPLATE. !!!
#
#  COMMENTED TEMPLATE ONLY — every value below is a <SET_IN_ENV> placeholder.
#
#  HOW IT IS LOADED (safe):
#    The application parses its environment file with dotenv (src/config/env.ts),
#    which reads plain KEY=VALUE and does NOT execute the file. Put the filled
#    file at the SERVER ROOT as ".env" (the path the app loads), mode 600, owned
#    by the deploy user:
#        cp deploy/.env.production.example .env   # then edit .env with real values
#        chmod 600 .env
#    Do NOT `source` / `. .env` in a shell — a secret containing $(...), backticks,
#    spaces or #/quotes would be executed or mangled. PM2 only needs the non-secret
#    NODE_ENV (set in deploy/ecosystem.config.cjs); the app reads the rest from .env.
#    For cron/shell scripts that need DB_* (backup/restore), load them the same safe
#    way:  node scripts/with-env.mjs bash scripts/backup-mysql.sh
#    (.gitignore already ignores ".env" / ".env.*"; keep the real file OUT of git.)
#
#  Every variable is validated at startup by src/config/env.ts. In production the
#  app also runs assertProductionConfig() and REFUSES TO START if any production
#  rule fails (notes marked [PROD-ENFORCED]).
###############################################################################

# ---- Core ------------------------------------------------------------------
# [PROD-ENFORCED] Must be exactly 'production' so Secure cookies, config
# validation and fail-closed behaviour are active. (PM2 also sets this.)
NODE_ENV=production

# Private port the Node app listens on. Nginx proxies to this; it MUST be
# firewalled off the public internet (see deploy/nginx.example.conf).
PORT=4000

# [PROD-ENFORCED] The REAL public origin of the SPA (scheme + host). Must NOT be
# localhost/127.0.0.1 in production. Used for CORS + CSRF origin screening.
# Same-origin deploy (recommended): this is the site the browser loads, e.g.
# https://app.example.com — Nginx serves the SPA and proxies /api to this app.
CLIENT_ORIGIN=https://<SET_IN_ENV_public_app_origin>

# ---- MySQL database --------------------------------------------------------
DB_HOST=<SET_IN_ENV_db_host>
DB_PORT=3306
DB_USER=<SET_IN_ENV_db_user>
DB_PASSWORD=<SET_IN_ENV_db_password>
# [PROD-ENFORCED] Must NOT be a *_test schema in production.
DB_NAME=<SET_IN_ENV_db_name>

# ---- Application secret -----------------------------------------------------
# [PROD-ENFORCED] HMACs reset/CSRF tokens; also the HKDF root for the SMS-outbox
# body key (only relevant if SMS is ever enabled). Min 32 chars; a weak/low-
# entropy/placeholder value is rejected at boot. Generate a strong one, e.g.:
#     openssl rand -hex 48
# Rotating APP_KEY invalidates sessions/tokens — plan a maintenance window.
APP_KEY=<SET_IN_ENV_64plus_hex_chars>

# Password hashing cost (10-15). 12 is a sane production default.
BCRYPT_ROUNDS=12

# ---- Sessions (lifecycle) --------------------------------------------------
# Defaults are production-sane; startup validates rotate < idle <= absolute,
# and grace <= 300s. Override only with intent.
SESSION_COOKIE_NAME=eg_session
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=720
SESSION_ROTATE_MINUTES=60
SESSION_ROTATION_GRACE_SECONDS=30
SESSION_TTL_HOURS=24
SESSION_REMEMBER_TTL_DAYS=180

# ---- Manual admin password recovery ----------------------------------------
# EasyGas is EMPLOYEE-ONLY and uses MANUAL recovery: an ADMIN issues a one-time
# temporary password (support is arranged over Telegram — SUPPORT_TELEGRAM_URL
# below); the employee must change it on first login. There is NO SMS/OTP self-
# service recovery. TEMP_PASSWORD_TTL_MINUTES is how long an admin-issued temporary
# password is accepted before the employee must ask for a new one.
TEMP_PASSWORD_TTL_MINUTES=1440

# ---- OTP / reset (only used if SMS is ever enabled) ------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MINUTES=10

# ---- Redis (REQUIRED in production) ----------------------------------------
# [PROD-ENFORCED] REDIS_URL must be set. Use TLS + auth in production:
#     rediss://<user>:<password>@<host>:<port>
# Fail-closed abuse controls (login/reset rate limits) depend on Redis.
REDIS_URL=rediss://<SET_IN_ENV_user>:<SET_IN_ENV_password>@<SET_IN_ENV_host>:6380
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=eg:

# ---- SMS provider — DISABLED by default (normal EasyGas configuration) -----
# The normal, supported configuration leaves SMS_PROVIDER UNSET: no enabled
# feature uses SMS after manual admin recovery replaced OTP, so the app boots and
# runs healthy with SMS disabled. Do NOT set SMS_PROVIDER=console in production
# (dev-only; it is refused at boot).
#
# (Optional, future) To enable SMS you would set SMS_PROVIDER=eskiz AND provide the
# Eskiz credentials below AND run the dedicated worker (see the OPTIONAL worker app
# in deploy/ecosystem.config.cjs). NOTE: the Eskiz adapter is a fail-closed STUB
# pending a verified official spec — until it is implemented, enabling SMS will keep
# the instance from booting. Leave SMS disabled unless/until that lands.
#
# SMS_PROVIDER=eskiz
# ESKIZ_EMAIL=<SET_IN_ENV_eskiz_email>
# ESKIZ_PASSWORD=<SET_IN_ENV_eskiz_password>
# ESKIZ_FROM=<SET_IN_ENV_approved_sender_name>
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Optional dedicated 32-byte outbox key (hex=64 chars or base64); UNSET ⇒ HKDF from
# APP_KEY. If set, must decode to exactly 32 bytes. Generate: openssl rand -hex 32
# SMS_OUTBOX_ENCRYPTION_KEY=<SET_IN_ENV_32_byte_hex_or_base64>
# SMS_MAX_ATTEMPTS=5
# SMS_REQUEST_TIMEOUT_MS=15000
# SMS_MAX_AGE_SECONDS=300
# SMS_WORKER_INTERVAL_MS=5000
# SMS_WORKER_BATCH=20
# SMS_LEASE_SECONDS=60

# ---- Object storage (S3/MinIO for evidence) --------------------------------
# [PROD-ENFORCED] Must be 's3' in production (local disk is refused unless the
# documented override is set). Use a PRIVATE bucket — evidence must never be
# publicly readable.
STORAGE_PROVIDER=s3
S3_BUCKET=<SET_IN_ENV_private_evidence_bucket>
S3_REGION=<SET_IN_ENV_region>
# S3_ENDPOINT: leave unset for AWS S3; REQUIRED for MinIO / S3-compatible.
# S3_ENDPOINT=https://<SET_IN_ENV_minio_endpoint>
# S3_FORCE_PATH_STYLE=true   # usually required for MinIO
# Prefer the standard AWS credential chain (instance role / profile) over keys here:
# S3_ACCESS_KEY_ID=<SET_IN_ENV_access_key>
# S3_SECRET_ACCESS_KEY=<SET_IN_ENV_secret_key>
S3_SERVER_SIDE_ENCRYPTION=AES256
# Emergency-only documented override to run local disk in production. Leave UNSET.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# STORAGE_LOCAL_DIR=./uploads   # only relevant if STORAGE_PROVIDER=local

# ---- Reverse proxy ---------------------------------------------------------
# [PROD-ENFORCED] Must be >= 1 in production. Set to EXACTLY the number of trusted
# proxy hops in front of the app. With a single Nginx (the documented topology)
# this is 1. Too high lets clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ---- GPS evidence policy ---------------------------------------------------
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_AGE_SECONDS=300
GPS_FUTURE_SKEW_SECONDS=120

# ---- Maintenance retention (days) ------------------------------------------
SESSION_RETENTION_DAYS=30
OTP_RETENTION_DAYS=7
SMS_OUTBOX_RETENTION_DAYS=30

# ---- Operational metrics (Prometheus) — PRIVATE, token-protected -----------
# OFF by default. If enabled, a strong METRICS_TOKEN is REQUIRED in production and
# the endpoint must be kept OFF the public vhost (deploy/nginx.example.conf blocks
# /api/v1/metrics). Scrape from your monitoring network with
# `Authorization: Bearer <token>`.
# METRICS_ENABLED=true
# METRICS_TOKEN=<SET_IN_ENV_32plus_char_random_token>

# ---- Support / misc --------------------------------------------------------
# Employee support / manual-recovery contact channel (shown in the app).
SUPPORT_TELEGRAM_URL=https://t.me/EasygasGarantbot

# ---- NOT for production ------------------------------------------------------
# TEST_DB_NAME is only for the isolated E2E suite (must end in _test). Do NOT set
# a real database here. Leave unset in production.
# TEST_DB_NAME=easygas_test
