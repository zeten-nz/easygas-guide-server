###############################################################################
#  EASY GAS — PRODUCTION ENVIRONMENT TEMPLATE  (Phase 10F artifact)
###############################################################################
#
#  !!!  DO NOT COMMIT THE REAL FILE.  DO NOT PUT REAL SECRETS IN THIS TEMPLATE. !!!
#
#  This is a COMMENTED TEMPLATE ONLY. Every value below is a placeholder of the
#  form <SET_IN_ENV>. Copy this to a file that is NEVER committed (e.g.
#  /srv/easygas/server/deploy/.env.production, mode 600, owned by the deploy
#  user) and fill in real values from your secret store.
#
#  NOTE: the repository .gitignore already ignores ".env" and ".env.*", which
#  ALSO matches this template's copied name. Keep the real file OUT of git.
#  (This example file itself may need `git add -f` to be tracked, by design —
#  double-check nothing sensitive is in it first.)
#
#  Every variable here is validated at startup by src/config/env.ts. In
#  production the app additionally runs assertProductionConfig() and REFUSES TO
#  START if any production rule fails (see notes marked [PROD-ENFORCED]).
#
#  Load it into the environment BEFORE starting PM2, e.g.:
#      set -a; . deploy/.env.production; set +a
#      pm2 start deploy/ecosystem.config.cjs
###############################################################################

# ---- Core ------------------------------------------------------------------
# [PROD-ENFORCED] Must be exactly 'production' so Secure cookies, config
# validation and fail-closed behaviour are active.
NODE_ENV=production

# Private port the Node app listens on. Nginx proxies to this; it MUST be
# firewalled off the public internet (see deploy/nginx.example.conf).
PORT=4000

# [PROD-ENFORCED] The REAL public origin of the SPA (scheme + host). Must NOT
# be localhost/127.0.0.1 in production. Used for CORS + CSRF origin screening.
CLIENT_ORIGIN=https://<SET_IN_ENV_public_app_origin>

# ---- MySQL database --------------------------------------------------------
DB_HOST=<SET_IN_ENV_db_host>
DB_PORT=3306
DB_USER=<SET_IN_ENV_db_user>
DB_PASSWORD=<SET_IN_ENV_db_password>
# [PROD-ENFORCED] Must NOT be a *_test schema in production.
DB_NAME=<SET_IN_ENV_db_name>

# ---- Application secret -----------------------------------------------------
# [PROD-ENFORCED] HMACs OTP codes, reset tokens and CSRF tokens; also the HKDF
# root for the SMS-outbox body key. Min 32 chars; a weak/low-entropy/placeholder
# value is rejected at boot. Generate a strong one, e.g.:
#     openssl rand -hex 48        # 96 hex chars
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating APP_KEY invalidates sessions/OTPs and re-derives the SMS-outbox key —
# drain the SMS outbox before rotating (see docs/PRODUCTION-RUNTIME-10C.md).
APP_KEY=<SET_IN_ENV_64plus_hex_chars>

# Password hashing cost (10-15). 12 is a sane production default.
BCRYPT_ROUNDS=12

# ---- Sessions (Phase 10C lifecycle) ----------------------------------------
# Defaults are production-sane; override only with intent. Startup validates
# rotate < idle <= absolute, and grace <= 300s.
SESSION_COOKIE_NAME=eg_session
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=720
SESSION_ROTATE_MINUTES=60
SESSION_ROTATION_GRACE_SECONDS=30
SESSION_TTL_HOURS=24
SESSION_REMEMBER_TTL_DAYS=180

# ---- OTP / reset -----------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MINUTES=10

# ---- Redis (Phase 10C — REQUIRED in production) ----------------------------
# [PROD-ENFORCED] REDIS_URL must be set. Use TLS + auth in production:
#     rediss://<user>:<password>@<host>:<port>
# Fail-closed abuse controls (login/OTP/reset rate limits) depend on Redis.
REDIS_URL=rediss://<SET_IN_ENV_user>:<SET_IN_ENV_password>@<SET_IN_ENV_host>:6380
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=eg:

# ---- SMS provider (Phase 10C) ----------------------------------------------
# [PROD-ENFORCED] 'console' is DEV-ONLY and refused in production. The real
# provider is Eskiz. NOTE (see docs/PRODUCTION-RUNTIME-10C.md): the Eskiz
# adapter is a fail-closed STUB pending a verified official spec — until it is
# implemented, a production instance will refuse to boot / stay 503. This
# template documents the config so it is ready.
SMS_PROVIDER=eskiz

# [PROD-ENFORCED when SMS_PROVIDER=eskiz]
ESKIZ_EMAIL=<SET_IN_ENV_eskiz_email>
ESKIZ_PASSWORD=<SET_IN_ENV_eskiz_password>
ESKIZ_FROM=<SET_IN_ENV_approved_sender_name>
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Durable outbox / worker tuning.
# Optional dedicated 32-byte outbox-body key (hex=64 chars, or base64). When
# UNSET, an HKDF subkey is derived deterministically from APP_KEY (survives
# restart). NEVER a random ephemeral value. If set, it must decode to exactly
# 32 bytes or the app fails closed. Generate: openssl rand -hex 32
# SMS_OUTBOX_ENCRYPTION_KEY=<SET_IN_ENV_32_byte_hex_or_base64>
SMS_MAX_ATTEMPTS=5
SMS_REQUEST_TIMEOUT_MS=15000
SMS_MAX_AGE_SECONDS=300
# On the dedicated SMS worker process set this 'true'; on API processes 'false'
# (PM2 sets these per-app in deploy/ecosystem.config.cjs — you normally do NOT
# set SMS_WORKER_ENABLED in this shared env file).
# SMS_WORKER_ENABLED=false
SMS_WORKER_INTERVAL_MS=5000
SMS_WORKER_BATCH=20
SMS_LEASE_SECONDS=60

# ---- Object storage (Phase 10B — S3/MinIO for evidence) --------------------
# [PROD-ENFORCED] Must be 's3' in production (local disk is refused unless the
# documented override is set). Use a PRIVATE bucket — evidence must never be
# publicly readable.
STORAGE_PROVIDER=s3
S3_BUCKET=<SET_IN_ENV_private_evidence_bucket>
S3_REGION=<SET_IN_ENV_region>
# S3_ENDPOINT: leave unset for AWS S3; REQUIRED for MinIO / S3-compatible.
# S3_ENDPOINT=https://<SET_IN_ENV_minio_endpoint>
# S3_FORCE_PATH_STYLE=true   # usually required for MinIO
# Prefer the standard AWS credential chain (instance role / profile) over
# embedding keys here. Set these only if you must:
# S3_ACCESS_KEY_ID=<SET_IN_ENV_access_key>
# S3_SECRET_ACCESS_KEY=<SET_IN_ENV_secret_key>
# Server-side encryption at rest (e.g. AES256 or aws:kms).
S3_SERVER_SIDE_ENCRYPTION=AES256
# Emergency-only documented override to run local disk in production. Leave
# UNSET/absent for real deployments.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# STORAGE_LOCAL_DIR=./uploads   # only relevant if STORAGE_PROVIDER=local

# ---- Reverse proxy (Phase 10A) ---------------------------------------------
# [PROD-ENFORCED] Must be >= 1 in production. Set to EXACTLY the number of
# trusted proxy hops in front of the app. With a single Nginx (the documented
# topology) this is 1. Too high lets clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ---- GPS evidence policy (Phase 10D) ---------------------------------------
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_AGE_SECONDS=300
GPS_FUTURE_SKEW_SECONDS=120

# ---- Maintenance retention (days, Phase 10C) -------------------------------
SESSION_RETENTION_DAYS=30
OTP_RETENTION_DAYS=7
SMS_OUTBOX_RETENTION_DAYS=30

# ---- Support / misc --------------------------------------------------------
SUPPORT_TELEGRAM_URL=https://t.me/EasygasGarantbot

# ---- NOT for production ------------------------------------------------------
# TEST_DB_NAME is only for the isolated E2E suite (must end in _test). Do NOT
# set a real database here. Leave unset in production.
# TEST_DB_NAME=easygas_test
