# EASY GAS server environment
# Copy to .env and fill in real values. NEVER commit the real .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easygas

# Server-side secret for HMAC'ing OTP codes and reset tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_KEY=

# Password hashing cost (10-15)
BCRYPT_ROUNDS=12

# Sessions
SESSION_COOKIE_NAME=eg_session
SESSION_TTL_HOURS=24
# "Remember me" keeps the session up to ~6 months
SESSION_REMEMBER_TTL_DAYS=180

# SMS
# "console" is DEVELOPMENT-ONLY (prints SMS to server console; refused in production).
# A real provider (e.g. Eskiz) must be implemented and configured before production.
SMS_PROVIDER=console
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MINUTES=10

# Support
SUPPORT_TELEGRAM_URL=https://t.me/EasygasGarantbot

# Initial admin account — used ONLY by the seed (seeds/03_admin_user.ts)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=EASY GAS

# Object storage: "local" writes under STORAGE_LOCAL_DIR (dev). S3/MinIO providers arrive with production setup.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Phase 10A — reverse-proxy trust: number of Nginx hops in front (0 = never
# trust X-Forwarded-For; production behind one Nginx: 1). See src/app.ts.
TRUST_PROXY_HOPS=0

# Phase 10A — isolated E2E test database (must end with "_test"; created by
# `npm run test:setup`). Destructive test cleanup refuses any other database.
TEST_DB_NAME=easygas_test

# Phase 10B — S3/MinIO object storage (production). See docs/EVIDENCE-STORAGE-10B.md.
# STORAGE_PROVIDER=s3
# S3_BUCKET=easygas-evidence
# S3_REGION=us-east-1
# S3_ENDPOINT=            # required for MinIO, optional for AWS
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=       # or rely on the standard AWS credential chain
# S3_SECRET_ACCESS_KEY=
# S3_SERVER_SIDE_ENCRYPTION=AES256
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true   # emergency override only

# --- Phase 10C: session lifecycle ---
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_MINUTES=720
SESSION_ROTATE_MINUTES=60
SESSION_ROTATION_GRACE_SECONDS=30

# --- Phase 10C: Redis (required in production) ---
# REDIS_URL=redis://127.0.0.1:6379         # rediss:// for TLS
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=eg:

# --- Phase 10C: durable SMS outbox / worker ---
# SMS_PROVIDER=eskiz                        # console (dev only) | eskiz
# Optional dedicated 32-byte outbox-body key (hex=64 chars, or base64). Unset =>
# HKDF subkey derived from APP_KEY (deterministic; survives restart). Never random.
# SMS_OUTBOX_ENCRYPTION_KEY=
SMS_MAX_ATTEMPTS=5
SMS_REQUEST_TIMEOUT_MS=15000
SMS_MAX_AGE_SECONDS=300
SMS_WORKER_ENABLED=true
SMS_WORKER_INTERVAL_MS=5000
SMS_WORKER_BATCH=20
SMS_LEASE_SECONDS=60

# --- Phase 10C: Eskiz provider (adapter deferred; see docs/PRODUCTION-RUNTIME-10C.md) ---
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=                               # approved sender name (requires Eskiz approval)
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# --- Phase 10C: maintenance retention (days) ---
SESSION_RETENTION_DAYS=30
OTP_RETENTION_DAYS=7
SMS_OUTBOX_RETENTION_DAYS=30
